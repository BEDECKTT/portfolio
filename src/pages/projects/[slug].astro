---
import { getCollection } from "astro:content";
import Layouts from "../../Layouts/Layouts.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { p },
  }));
}

interface Prop {
  p: {
    slug: string;
    data: {
      title: string;
      ShortDescription: string;
      tags?: string[];
      coverImage?: string;
    };
    render: () => Promise<{ Content: any; headings: { depth: number; slug: string; text: string }[] }>;
  };
}

const { p } = Astro.props as Prop;
const { Content, headings } = await p.render();
---

<Layouts title={p.data.title} description={p.data.ShortDescription}>

  <!-- Back link -->
  <div class="pt-24 pb-4 max-w-5xl mx-auto px-4" data-animate="left">
    <a
      href="/#projects"
      class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors duration-200 text-sm font-medium group"
    >
      <span class="group-hover:-translate-x-1 transition-transform duration-200">←</span>
      Volver a Proyectos
    </a>
  </div>

  <!-- Project header -->
  <header class="project-hero max-w-5xl mx-auto px-4 pb-10" data-animate="scale" data-animate-delay="1">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.28em] text-accent">Proyecto · Detalle técnico</p>
    <h1 class="electric-text text-4xl sm:text-5xl font-extrabold leading-tight mb-4">
      {p.data.title}
    </h1>
    <p class="text-lg sm:text-xl text-muted leading-relaxed max-w-2xl">
      {p.data.ShortDescription}
    </p>
    {p.data.tags && p.data.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {p.data.tags.map((tag) => (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
            {tag}
          </span>
        ))}
      </div>
    )}
  </header>

  <!-- Main content area: sidebar TOC on lg+, stacked on smaller -->
  <div class="max-w-5xl mx-auto px-4 pb-20">
    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12 lg:items-start">

      <!-- Article content -->
      <article
        data-animate="left"
        data-animate-delay="2"
        class="prose prose-invert max-w-none
               prose-headings:text-text prose-headings:font-bold
               prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl
               prose-p:text-muted prose-p:leading-relaxed
               prose-a:text-accent prose-a:no-underline hover:prose-a:underline
               prose-strong:text-text
               prose-code:text-accent prose-code:bg-surface-2 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
               prose-pre:bg-surface-2 prose-pre:border prose-pre:border-[var(--color-border)] prose-pre:rounded-xl prose-pre:overflow-x-auto
               prose-blockquote:border-l-accent prose-blockquote:text-muted prose-blockquote:not-italic
               prose-ul:text-muted prose-ol:text-muted prose-li:text-muted
               prose-th:text-text prose-td:text-muted
               prose-hr:border-[var(--color-border)]
               [&_pre]:!bg-[var(--color-surface-2)]"
      >
        <Content />
      </article>

      <!-- Table of Contents -->
      {headings.length > 0 && (
        <aside class="order-first lg:order-last" data-animate="right" data-animate-delay="3">

          <!-- Mobile: collapsible <details> accordion -->
          <details class="lg:hidden mb-8 bg-surface border border-[var(--color-border)] rounded-xl overflow-hidden group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer select-none font-semibold text-text list-none">
              <span>Tabla de Contenidos</span>
              <svg
                class="w-4 h-4 text-muted transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <nav aria-label="Tabla de contenidos" class="px-5 pb-5 pt-2">
              <ul class="space-y-1.5">
                {headings.map((heading) => (
                  <li style={`padding-left: ${(heading.depth - 1) * 12}px`}>
                    <a
                      href={`#${heading.slug}`}
                      class="block text-sm text-muted hover:text-accent transition-colors duration-200 py-0.5"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>

          <!-- Desktop: sticky sidebar -->
          <div class="hidden lg:block sticky top-24">
            <div class="bg-surface border border-[var(--color-border)] rounded-xl p-5">
              <h2 class="text-sm font-semibold text-text uppercase tracking-wider mb-4">
                Tabla de Contenidos
              </h2>
              <nav aria-label="Tabla de contenidos">
                <ul class="space-y-1.5">
                  {headings.map((heading) => (
                    <li style={`padding-left: ${(heading.depth - 1) * 12}px`}>
                      <a
                        href={`#${heading.slug}`}
                        class="block text-sm text-muted hover:text-accent transition-colors duration-200 py-0.5"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>

        </aside>
      )}

    </div>
  </div>

</Layouts>

<style is:global>
  .project-hero {
    position: relative;
  }

  .project-hero::after {
    content: '';
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2), transparent 80%);
    box-shadow: 0 0 16px var(--color-glow);
  }

  /* Ensure Shiki code blocks look right in dark mode */
  .prose pre {
    background-color: var(--color-surface-2) !important;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow-x: auto;
    padding: 1.25rem 1.5rem;
    margin-block: 1.5rem;
  }

  /* Remove extra border/bg from inline code inside pre */
  .prose pre code {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    font-size: 0.875rem;
    color: inherit;
  }

  /* Light mode: switch to a lighter code background */
  [data-theme="light"] .prose pre {
    background-color: var(--color-surface-2) !important;
    border-color: var(--color-border);
  }

  /* Smooth scroll for TOC links (global.css already sets scroll-behavior on html, this is a fallback) */
  .toc-link {
    scroll-behavior: smooth;
  }

  /* <details> summary — remove the default arrow in WebKit */
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
