---
import Layout from "../Layouts/Layouts.astro";
import TechCard from "../Components/TechCard.astro";
import ProjectCards from "../Components/ProjectCards.astro";
import EducationTimeline from "../Components/EducationTimeline.astro";
import RoadmapSection from "../Components/RoadmapSection.astro";
import { getCollection } from "astro:content";
import { technologies } from "../data/technologies";

const projects = await getCollection("projects");
---

<Layout title="Robi Williams — Portfolio" description="Estudiante de Ingeniería en Sistemas, Backend Developer y AI Enthusiast.">

  <!-- ===================== HERO ===================== -->
  <section id="hero" class="relative min-h-screen flex items-center pt-16">
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center py-16">

      <!-- Photo (left on desktop, top on mobile) -->
      <div class="flex justify-center order-1 md:order-none" data-animate="scale" data-animate-delay="1">
        <div class="profile-shell">
          <span class="profile-orbit" aria-hidden="true"></span>
          <span class="profile-orbit profile-orbit--second" aria-hidden="true"></span>
          <img
            src="/images/descarga.jpg"
            alt="Foto de perfil de Robi Williams"
            class="relative w-52 h-52 md:w-64 md:h-64 rounded-full object-cover border-4 border-accent/40 shadow-2xl shadow-accent/20"
          />
        </div>
      </div>

      <!-- Text (right on desktop, below on mobile) -->
      <div class="flex flex-col gap-6 text-center md:text-left order-2 md:order-none">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--color-text)] leading-tight" data-animate data-animate-delay="2">
          Robi Williams<br />
          <span class="electric-text">Mejia</span>
        </h1>

        <!-- Animated cycling role text -->
        <div class="text-lg md:text-xl text-[var(--color-text-muted)] font-medium h-8 overflow-hidden" data-animate data-animate-delay="3">
          <div id="role-text" class="role-text" aria-live="polite">
            Software Engineering Student
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-3 justify-center md:justify-start" data-animate data-animate-delay="4">
          <a
            href="#projects"
            class="electric-button px-6 py-3 rounded-lg font-semibold"
          >
            Ver Proyectos
          </a>
          <a
            href="/cv.pdf"
            download="Robi-Williams-Mejia-CV.pdf"
            aria-label="Descargar currículum de Robi Williams Mejia en formato PDF"
            class="electric-button--outline px-6 py-3 rounded-lg border border-accent text-accent font-semibold"
          >
            Descargar CV
          </a>
          <a
            href="#contact"
            class="electric-button--outline px-6 py-3 rounded-lg border border-[var(--color-border)] text-[var(--color-text)] font-semibold"
          >
            Contacto
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Animated cycling role text
    const roles = [
      "Software Engineering Student",
      "Backend Developer",
      "AI Enthusiast"
    ];
    let current = 0;
    const el = document.getElementById('role-text');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (el && !reducedMotion) {
      setInterval(() => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        el.style.filter = 'blur(5px)';
        setTimeout(() => {
          current = (current + 1) % roles.length;
          el.textContent = roles[current];
          el.style.transform = 'translateY(8px)';
          requestAnimationFrame(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
            el.style.filter = 'blur(0)';
          });
        }, 420);
      }, 3000);
    }
  </script>

  <!-- ===================== ABOUT ===================== -->
  <section id="about" class="py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

      <!-- Text content -->
      <div data-animate="left">
        <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-6">Sobre Mí</h2>
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-6">
        Estudiante de último año de Ingeniería en Sistemas con experiencia 
        en el desarrollo de soluciones tecnológicas, gestión de bases de datos
        y análisis de requerimientos. He participado en la implementación de 
        sistemas de información, diseño de bases de datos relacionales, desarrollo de 
        APIs y automatización de procesos orientados a mejorar la eficiencia operativa.

        Poseo conocimientos en desarrollo backend, integración de sistemas, 
        modelado de datos y tecnologías web, complementados con una sólida 
        capacidad analítica y de resolución de problemas. Me interesa especialmente 
        la ingeniería de software, la inteligencia artificial, la ciencia de datos y el 
        desarrollo de soluciones innovadoras que generen impacto real en organizaciones 
        y usuarios.

        Me caracterizo por mi aprendizaje continuo, adaptabilidad a nuevas tecnologías 
        y compromiso con la creación de software escalable, eficiente y alineado 
        con las necesidades del negocio.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="px-3 py-1 rounded-full text-sm font-medium border border-accent/40 text-accent bg-accent/10">
            Backend Developer
          </span>
          <span class="px-3 py-1 rounded-full text-sm font-medium border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)]">
            Ingeniería en Sistemas
          </span>
          <span class="px-3 py-1 rounded-full text-sm font-medium border border-[var(--color-border)] text-[var(--color-text-muted)] bg-[var(--color-surface)]">
            AI Enthusiast
          </span>
        </div>
      </div>

      <!-- Decorative visual element -->
      <div class="flex justify-center" data-animate="right" data-animate-delay="2">
        <div class="electric-card w-full max-w-xs p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]/90 backdrop-blur-sm">
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <span class="floating-icon text-2xl">⚙️</span>
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">Backend</p>
                <p class="text-xs text-[var(--color-text-muted)]">C#, JavaScript, TypeScript, Node.js, Go</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="floating-icon text-2xl">🗄️</span>
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">Bases de Datos</p>
                <p class="text-xs text-[var(--color-text-muted)]">SQL Server, Oracle Database</p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="floating-icon text-2xl">🤖</span>
              <div>
                <p class="text-sm font-semibold text-[var(--color-text)]">Inteligencia Artificial</p>
                <p class="text-xs text-[var(--color-text-muted)]">Spark, Databricks, Scala, Python</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== TECHNOLOGIES ===================== -->
  <section id="technologies" class="py-20">
    <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-10">Mis Habilidades</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {technologies.map((cat, i) => (
        <div data-animate data-animate-delay={String(Math.min(i + 1, 5))}>
          <TechCard
            category={cat.category}
            categoryIcon={cat.categoryIcon}
            tech={cat.tech}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== PROJECTS ===================== -->
  <section id="projects" class="py-20">
    <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-10">Proyectos Trabajados</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((p, i) => (
        <div data-animate={i % 2 === 0 ? 'left' : 'right'} data-animate-delay={`p${Math.min(i + 1, 4)}`}>
          <ProjectCards
            title={p.data.title}
            description={p.data.ShortDescription}
            link={`/projects/${p.slug}`}
            tags={p.data.tags}
            coverImage={p.data.coverImage}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- ===================== EDUCATION ===================== -->
  <EducationTimeline />

  <!-- ===================== ROADMAP ===================== -->
  <RoadmapSection />

  <!-- ===================== CONTACT ===================== -->
  <section id="contact" class="py-20">
    <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-10">Contacto</h2>
    <div class="flex flex-col sm:flex-row gap-4 max-w-2xl" data-animate>
        <a
          href="https://github.com/BEDECKTT"
          target="_blank"
          rel="noopener noreferrer"
          class="electric-card flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] group"
        >
          <svg class="w-6 h-6 text-[var(--color-text)] group-hover:text-accent transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <div>
            <p class="font-semibold text-[var(--color-text)]">GitHub</p>
            <p class="text-sm text-[var(--color-text-muted)]">github.com/BEDECKTT</p>
          </div>
        </a>

        <a
          href="https://linkedin.com/in/"
          target="_blank"
          rel="noopener noreferrer"
          class="electric-card flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] group"
        >
          <svg class="w-6 h-6 text-[var(--color-text)] group-hover:text-accent transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          <div>
            <p class="font-semibold text-[var(--color-text)]">LinkedIn</p>
            <p class="text-sm text-[var(--color-text-muted)]">Conéctate conmigo</p>
          </div>
        </a>

        <a
          href="mailto:robiw@email.com"
          class="electric-card flex items-center gap-4 p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] group"
        >
          <svg class="w-6 h-6 text-[var(--color-text)] group-hover:text-accent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <div>
            <p class="font-semibold text-[var(--color-text)]">Email</p>
            <p class="text-sm text-[var(--color-text-muted)]">robimejia381@gmail.com</p>
          </div>
        </a>
      </div>
    </div>
  </section>

</Layout>
