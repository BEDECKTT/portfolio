---
interface Props {
  title: string;
  description: string;
  link: string;
  tags?: string[];
  coverImage?: string;
}

const { title, description, link, tags = [], coverImage } = Astro.props;

type VisualType = 'ai' | 'go' | 'mental-health' | 'warehouse' | 'commerce' | 'orders' | 'vision' | 'social' | 'generic';

const normalizedTitle = title.toLocaleLowerCase('es');
let visualType: VisualType = 'generic';

if (normalizedTitle.includes('académico') || normalizedTitle.includes('inteligencia artificial')) visualType = 'ai';
else if (normalizedTitle.includes('proyecto go')) visualType = 'go';
else if (normalizedTitle.includes('depression') || normalizedTitle.includes('depresión')) visualType = 'mental-health';
else if (normalizedTitle.includes('warehouse')) visualType = 'warehouse';
else if (normalizedTitle.includes('e-commerce') || normalizedTitle.includes('tiendas físicas')) visualType = 'commerce';
else if (normalizedTitle.includes('pedidos')) visualType = 'orders';
else if (normalizedTitle.includes('machine learning') || normalizedTitle.includes('visión artificial')) visualType = 'vision';
else if (normalizedTitle.includes('red social')) visualType = 'social';
---

<article class="project-card group flex h-full flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden">
  <!-- Cover image or gradient placeholder -->
  {coverImage ? (
    <div class="project-visual overflow-hidden">
      <img
        src={coverImage}
        alt={`Preview de ${title}`}
        loading="lazy"
        class="project-cover w-full h-44 object-cover"
      />
    </div>
  ) : (
    <div class={`project-visual project-placeholder visual-${visualType} w-full h-44 flex items-center justify-center`} aria-hidden="true">
      <span class="visual-glow"></span>

      {visualType === 'ai' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-line signal-line" d="M43 47 91 68M277 45l-48 23M42 132l52-27M276 133l-49-28" />
          <circle class="visual-node pulse-node" cx="40" cy="45" r="6" />
          <circle class="visual-node" cx="280" cy="43" r="5" />
          <circle class="visual-node" cx="39" cy="134" r="5" />
          <circle class="visual-node pulse-node delay" cx="280" cy="135" r="6" />
          <rect class="visual-panel" x="91" y="37" width="138" height="102" rx="24" />
          <path class="visual-accent" d="M125 73h70M125 94h48M125 115h29" />
          <path class="visual-fill" d="m194 112 17 15-4-24Z" />
          <circle class="visual-core" cx="160" cy="87" r="47" />
          <text class="visual-label" x="160" y="23" text-anchor="middle">LOCAL AI AGENT</text>
        </svg>
      ) : visualType === 'go' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-line signal-line" d="M63 88h52M205 88h52M160 34v24M160 118v24" />
          <circle class="visual-node" cx="53" cy="88" r="10" />
          <circle class="visual-node pulse-node" cx="267" cy="88" r="10" />
          <circle class="visual-node" cx="160" cy="24" r="8" />
          <circle class="visual-node" cx="160" cy="152" r="8" />
          <path class="visual-panel" d="m160 50 48 27v54l-48 27-48-27V77Z" />
          <text class="visual-monogram" x="160" y="113" text-anchor="middle">GO</text>
          <text class="visual-label" x="160" y="42" text-anchor="middle">gRPC NETWORK</text>
        </svg>
      ) : visualType === 'mental-health' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-panel" d="M111 143v-25c-17-13-27-34-27-56 0-35 29-54 65-54 37 0 67 25 67 59 0 18-8 34-22 45v31" />
          <path class="visual-accent chart-line" d="M72 91h38l13-23 18 50 17-33 14 18h75" />
          <circle class="visual-core" cx="149" cy="64" r="33" />
          <circle class="visual-node pulse-node" cx="123" cy="68" r="5" />
          <circle class="visual-node" cx="173" cy="85" r="5" />
          <text class="visual-label" x="224" y="35" text-anchor="middle">DATA + WELLBEING</text>
        </svg>
      ) : visualType === 'warehouse' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-line signal-line" d="M87 49h56M87 88h56M87 127h56M222 49h20M222 88h20M222 127h20" />
          <g class="database-stack">
            <ellipse class="visual-panel" cx="64" cy="43" rx="28" ry="10" />
            <path class="visual-panel" d="M36 43v20c0 6 13 10 28 10s28-4 28-10V43" />
            <ellipse class="visual-panel" cx="64" cy="82" rx="28" ry="10" />
            <path class="visual-panel" d="M36 82v20c0 6 13 10 28 10s28-4 28-10V82" />
            <ellipse class="visual-panel" cx="64" cy="121" rx="28" ry="10" />
            <path class="visual-panel" d="M36 121v20c0 6 13 10 28 10s28-4 28-10v-20" />
          </g>
          <rect class="visual-panel" x="143" y="28" width="79" height="122" rx="13" />
          <path class="visual-accent chart-line" d="m158 122 15-26 14 11 19-42" />
          <path class="visual-accent" d="M158 53h49M158 69h30" />
          <circle class="visual-node" cx="253" cy="49" r="10" />
          <circle class="visual-node pulse-node" cx="253" cy="88" r="10" />
          <circle class="visual-node" cx="253" cy="127" r="10" />
          <text class="visual-label" x="182" y="20" text-anchor="middle">BI PIPELINE</text>
        </svg>
      ) : visualType === 'commerce' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-panel" d="M70 72h142v83H70z" />
          <path class="visual-fill" d="M58 69h166l-17-37H75Z" />
          <path class="visual-accent" d="M58 69c0 13 23 15 28 2 5 13 27 13 32 0 6 13 28 13 33 0 6 13 28 13 33 0 5 13 28 11 28-2" />
          <rect class="visual-panel" x="92" y="93" width="43" height="62" rx="5" />
          <rect class="visual-panel" x="151" y="91" width="39" height="30" rx="5" />
          <path class="visual-accent cart-path" d="M220 101h22l8 31h31l7-22h-43M252 144h1M278 144h1" />
          <text class="visual-label" x="266" y="88" text-anchor="middle">SHOP</text>
        </svg>
      ) : visualType === 'orders' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <rect class="visual-panel" x="63" y="24" width="113" height="132" rx="16" />
          <path class="visual-fill" d="M94 22h51v20H94z" />
          <path class="visual-accent" d="m86 69 8 8 15-17M119 69h36M86 100l8 8 15-17M119 100h36M86 131l8 8 15-17M119 131h28" />
          <path class="visual-panel box-float" d="m224 55 41 20v47l-41 21-41-21V75Z" />
          <path class="visual-accent" d="m183 75 41 20 41-20M224 95v48M203 65l41 20" />
          <text class="visual-label" x="224" y="39" text-anchor="middle">ORDER FLOW</text>
        </svg>
      ) : visualType === 'vision' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-accent focus-corner" d="M69 62V35h27M224 35h27v27M69 115v27h27M251 115v27h-27" />
          <path class="visual-panel" d="M92 88s26-42 68-42 68 42 68 42-26 42-68 42S92 88 92 88Z" />
          <circle class="visual-core" cx="160" cy="88" r="29" />
          <circle class="visual-fill scanner" cx="160" cy="88" r="12" />
          <path class="visual-line signal-line" d="M43 44h20M257 44h20M43 132h20M257 132h20" />
          <circle class="visual-node" cx="37" cy="44" r="5" />
          <circle class="visual-node pulse-node" cx="283" cy="44" r="5" />
          <circle class="visual-node" cx="37" cy="132" r="5" />
          <circle class="visual-node" cx="283" cy="132" r="5" />
          <text class="visual-label" x="160" y="23" text-anchor="middle">COMPUTER VISION</text>
        </svg>
      ) : visualType === 'social' ? (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-line signal-line" d="m160 87-74-42M160 87l78-43M160 87l-83 52M160 87l82 51" />
          <circle class="visual-core" cx="160" cy="83" r="31" />
          <circle class="visual-fill" cx="160" cy="76" r="10" />
          <path class="visual-fill" d="M142 102c4-11 12-16 18-16s14 5 18 16" />
          <g class="social-node">
            <circle class="visual-panel" cx="76" cy="39" r="22" /><circle class="visual-node" cx="76" cy="35" r="6" /><path class="visual-accent" d="M65 49c3-7 8-10 11-10s8 3 11 10" />
            <circle class="visual-panel" cx="247" cy="38" r="22" /><circle class="visual-node" cx="247" cy="34" r="6" /><path class="visual-accent" d="M236 48c3-7 8-10 11-10s8 3 11 10" />
            <circle class="visual-panel" cx="66" cy="143" r="22" /><circle class="visual-node" cx="66" cy="139" r="6" /><path class="visual-accent" d="M55 153c3-7 8-10 11-10s8 3 11 10" />
            <circle class="visual-panel" cx="253" cy="142" r="22" /><circle class="visual-node" cx="253" cy="138" r="6" /><path class="visual-accent" d="M242 152c3-7 8-10 11-10s8 3 11 10" />
          </g>
          <text class="visual-label" x="160" y="21" text-anchor="middle">CONNECTED PEOPLE</text>
        </svg>
      ) : (
        <svg class="visual-art" viewBox="0 0 320 176" fill="none">
          <path class="visual-line signal-line" d="m74 130 52-75 63 66 57-76" />
          <circle class="visual-node" cx="74" cy="130" r="12" />
          <circle class="visual-node pulse-node" cx="126" cy="55" r="12" />
          <circle class="visual-node" cx="189" cy="121" r="12" />
          <circle class="visual-node" cx="246" cy="45" r="12" />
          <path class="visual-accent" d="M52 149h216" />
          <text class="visual-label" x="160" y="25" text-anchor="middle">DIGITAL PROJECT</text>
        </svg>
      )}
    </div>
  )}

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5 gap-3">
    <h3 class="text-lg font-bold text-[var(--color-text)] group-hover:text-accent transition-colors duration-200">
      {title}
    </h3>
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed flex-1 line-clamp-3">
      {description}
    </p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag, index) => (
          <span class="project-tag px-2 py-0.5 rounded-full text-xs font-medium border border-[var(--color-border)] bg-[var(--color-surface-2)] text-[var(--color-text-muted)]" style={`--tag-index: ${index}`}>
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Link -->
    <a
      href={link}
      class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:text-accent/80 transition-colors duration-200 mt-auto"
    >
      Ver más
      <svg class="project-arrow w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    isolation: isolate;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.1);
    transition: transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1), border-color 380ms ease,
      box-shadow 380ms ease;
  }

  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 25%, color-mix(in srgb, var(--color-accent) 13%, transparent) 48%, transparent 70%);
    transform: translateX(-135%);
    transition: transform 750ms ease;
  }

  .project-card:hover {
    transform: translateY(-9px) scale(1.012);
    border-color: color-mix(in srgb, var(--color-accent) 62%, transparent);
    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.2), 0 0 34px var(--color-glow);
  }

  .project-card:hover::after {
    transform: translateX(135%);
  }

  .project-visual {
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .project-cover {
    transition: transform 650ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 650ms ease;
  }

  .project-card:hover .project-cover {
    transform: scale(1.07);
    filter: saturate(1.2) contrast(1.04);
  }

  .project-placeholder {
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--color-accent) 20%, transparent), transparent 32%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 20%, var(--color-surface-2)), var(--color-surface-2) 48%, color-mix(in srgb, var(--color-accent-2) 22%, var(--color-surface-2)));
  }

  .project-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--color-grid) 1px, transparent 1px), linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(circle, black, transparent 72%);
  }

  .project-placeholder::after {
    content: '';
    position: absolute;
    inset: auto -10% -70% 35%;
    height: 130%;
    background: var(--visual-secondary, var(--color-accent-2));
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.2;
  }

  .visual-ai { --visual-secondary: #ff2bd6; }
  .visual-go { --visual-secondary: #00add8; }
  .visual-mental-health { --visual-secondary: #ff4d8d; }
  .visual-warehouse { --visual-secondary: #7b61ff; }
  .visual-commerce { --visual-secondary: #ff8a00; }
  .visual-orders { --visual-secondary: #00f5a0; }
  .visual-vision { --visual-secondary: #a855f7; }
  .visual-social { --visual-secondary: #2f80ff; }

  .visual-glow {
    position: absolute;
    width: 9rem;
    height: 9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--visual-secondary, var(--color-accent)) 30%, transparent);
    filter: blur(36px);
    animation: visual-breathe 4s ease-in-out infinite;
  }

  .visual-art {
    position: relative;
    z-index: 2;
    width: min(92%, 340px);
    height: 100%;
    color: var(--color-accent);
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--color-accent) 28%, transparent));
    transition: transform 550ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 550ms ease;
  }

  .project-card:hover .visual-art {
    transform: scale(1.045) translateY(-2px);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--color-accent) 42%, transparent));
  }

  .visual-line,
  .visual-panel,
  .visual-accent {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .visual-line {
    stroke: color-mix(in srgb, var(--color-accent) 45%, transparent);
    stroke-width: 2;
  }

  .visual-panel {
    fill: color-mix(in srgb, var(--color-surface) 72%, transparent);
    stroke: color-mix(in srgb, var(--color-accent) 70%, transparent);
    stroke-width: 2;
  }

  .visual-accent {
    fill: none;
    stroke: var(--visual-secondary, var(--color-accent));
    stroke-width: 3;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--visual-secondary, var(--color-accent)) 65%, transparent));
  }

  .visual-fill {
    fill: var(--visual-secondary, var(--color-accent));
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--visual-secondary, var(--color-accent)) 55%, transparent));
  }

  .visual-core {
    fill: color-mix(in srgb, var(--color-surface-2) 82%, transparent);
    stroke: var(--color-accent);
    stroke-width: 2;
    filter: drop-shadow(0 0 8px var(--color-glow));
  }

  .visual-node {
    fill: var(--color-accent);
    filter: drop-shadow(0 0 7px var(--color-glow));
  }

  .visual-label {
    fill: var(--color-text-muted);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .visual-monogram {
    fill: var(--color-text);
    font-size: 31px;
    font-weight: 800;
    letter-spacing: -2px;
  }

  .signal-line,
  .chart-line {
    stroke-dasharray: 8 7;
    animation: signal-flow 4s linear infinite;
  }

  .pulse-node {
    animation: node-pulse 2.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .pulse-node.delay {
    animation-delay: -1.1s;
  }

  .scanner {
    animation: scanner-pulse 2.5s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .box-float,
  .database-stack,
  .social-node {
    animation: element-float 3.8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .cart-path,
  .focus-corner {
    animation: accent-flash 2.8s ease-in-out infinite;
  }

  .project-tag {
    transition: color 220ms ease, border-color 220ms ease, transform 220ms ease;
  }

  .project-card:hover .project-tag {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    transform: translateY(-2px);
    transition-delay: calc(var(--tag-index) * 35ms);
  }

  .project-arrow {
    transition: transform 220ms ease;
  }

  .project-card:hover .project-arrow {
    transform: translateX(5px);
  }

  @keyframes visual-breathe {
    0%, 100% { opacity: 0.45; transform: scale(0.85); }
    50% { opacity: 0.8; transform: scale(1.12); }
  }

  @keyframes signal-flow {
    to { stroke-dashoffset: -60; }
  }

  @keyframes node-pulse {
    0%, 100% { opacity: 0.65; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.25); }
  }

  @keyframes scanner-pulse {
    0%, 100% { opacity: 0.65; transform: scale(0.75); }
    50% { opacity: 1; transform: scale(1.18); }
  }

  @keyframes element-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  @keyframes accent-flash {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>
