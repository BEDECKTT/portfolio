---
import { milestones } from '../data/roadmap';
---

<section id="roadmap" class="py-20">
  <div class="mb-12 max-w-3xl">
    <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-5">Ruta de Objetivos Profesionales</h2>
    <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed" data-animate>
      Una evolución desde la ingeniería de software hacia el diseño de soluciones, la toma de decisiones técnicas y el liderazgo de productos tecnológicos.
    </p>
  </div>

  <div class="relative">
    <ol class="grid grid-cols-1 md:grid-cols-4 gap-6">
      {milestones.map((milestone, i) => (
        <li
          class="roadmap-step relative min-w-0 pl-14 md:pl-0 md:flex md:flex-col md:items-center"
          data-animate
          data-animate-delay={`e${Math.min(i + 1, 3)}`}
        >
          <div
            class={`roadmap-node absolute left-0 top-0 md:relative md:left-auto md:top-auto z-10 w-10 h-10 shrink-0 rounded-full border-2 flex items-center justify-center md:mb-4 transition-all duration-300 ${
              milestone.status === 'current'
                ? 'border-accent bg-accent text-white'
                : 'border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)]'
            }`}
            aria-hidden="true"
          >
            <span class="text-sm font-bold">{i + 1}</span>
          </div>

          <div
            class={`electric-card roadmap-card w-full min-w-0 md:flex-1 p-5 rounded-2xl border ${
              milestone.status === 'current'
                ? 'border-accent/50 bg-accent/10'
                : 'border-[var(--color-border)] bg-[var(--color-surface)]'
            }`}
          >
            {milestone.timeframe && (
              <p class="text-xs font-semibold uppercase tracking-wider text-accent mb-2">
                {milestone.timeframe}
              </p>
            )}
            <h3
              class={`text-base font-bold leading-snug mb-3 [overflow-wrap:anywhere] ${
                milestone.status === 'current' ? 'text-accent' : 'text-[var(--color-text)]'
              }`}
            >
              {milestone.title}
            </h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed [overflow-wrap:anywhere]">
              {milestone.description}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .roadmap-step:not(:last-child)::after {
    content: '';
    position: absolute;
    z-index: 0;
    left: 1.25rem;
    top: 1.25rem;
    bottom: -2.75rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-accent-2));
    box-shadow: 0 0 10px var(--color-glow);
    opacity: 0.6;
  }

  .roadmap-node {
    box-shadow: 0 0 16px var(--color-glow);
  }

  .roadmap-card {
    transition-duration: 400ms;
  }

  @media (min-width: 768px) {
    .roadmap-step:not(:last-child)::after {
      left: 50%;
      top: 1.25rem;
      bottom: auto;
      width: calc(100% + 1.5rem);
      height: 1px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roadmap-node,
    .roadmap-card {
      transition: none;
    }
  }
</style>
