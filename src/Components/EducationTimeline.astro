---
import { educationEntries } from '../data/education';
---

<section id="education" class="py-20">
  <h2 class="section-title text-3xl font-bold text-[var(--color-text)] mb-10">Educación</h2>

  <div class="relative">
    <!-- Vertical line -->
    <div class="timeline-beam absolute left-4 top-0 bottom-0 w-px" aria-hidden="true"></div>

    <div class="flex flex-col gap-8">
      {educationEntries.map((entry, i) => (
        <div
          class="relative pl-12"
          data-animate
          data-animate-delay={`e${Math.min(i + 1, 3)}`}
        >
          <!-- Timeline dot -->
          <div class="timeline-node absolute left-0 top-1 w-8 h-8 rounded-full border-2 border-accent bg-[var(--color-surface)] flex items-center justify-center" aria-hidden="true">
            <div class="w-2 h-2 rounded-full bg-accent shadow-lg shadow-accent"></div>
          </div>

          <!-- Card -->
          <div class="electric-card p-5 sm:p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)]">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-3">
              <div class="min-w-0">
                <h3 class="text-lg font-bold leading-snug text-[var(--color-text)] [overflow-wrap:anywhere]">
                  {entry.degree}
                </h3>
                <p class="mt-1 text-sm font-medium text-[var(--color-text-muted)] [overflow-wrap:anywhere]">
                  {entry.institution}
                </p>
                <p class="mt-2 inline-flex items-center gap-1.5 text-xs text-[var(--color-text-muted)]">
                  <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {entry.location}
                </p>
              </div>
              <div class="flex shrink-0 flex-row flex-wrap items-center gap-2 sm:flex-col sm:items-end">
                <span class="text-xs font-medium text-[var(--color-text-muted)]">{entry.period}</span>
                <span
                  class={`px-3 py-0.5 rounded-full text-xs font-semibold border ${
                    entry.status === 'En Curso'
                      ? 'border-accent/40 text-accent bg-accent/10'
                      : 'border-green-500/40 text-green-400 bg-green-500/10'
                  }`}
                >
                  {entry.status}
                </span>
              </div>
            </div>
            {entry.description && (
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{entry.description}</p>
            )}
            {entry.expectedGraduation && (
              <div class="mt-4 inline-flex max-w-full items-center gap-2 rounded-lg border border-accent/30 bg-accent/10 px-3 py-2 text-xs font-semibold text-accent">
                <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path stroke-linecap="round" d="M8 3v4M16 3v4M3 10h18" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8 15 2.2 2.2L16 12" />
                </svg>
                <span class="[overflow-wrap:anywhere]">Graduación esperada: {entry.expectedGraduation}</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-beam {
    background: linear-gradient(to bottom, var(--color-accent), var(--color-accent-2), var(--color-accent-3));
    box-shadow: 0 0 12px var(--color-glow);
  }

  .timeline-node {
    box-shadow: 0 0 18px var(--color-glow);
    animation: timeline-charge 2.8s ease-in-out infinite;
  }

  @keyframes timeline-charge {
    0%, 100% { box-shadow: 0 0 8px var(--color-glow); }
    50% { box-shadow: 0 0 24px var(--color-glow); }
  }
</style>
