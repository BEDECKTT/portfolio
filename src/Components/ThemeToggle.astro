---
// No props needed — ThemeToggle reads and writes directly to the DOM and localStorage
---

<button
  id="theme-toggle"
  aria-label="Cambiar a modo claro"
  class="electric-toggle p-2 rounded-lg hover:bg-[var(--color-surface-2)] transition-all duration-300 text-[var(--color-text)] cursor-pointer"
>
  <!-- Sun icon: visible when dark mode is active (clicking switches to light) -->
  <svg
    class="sun-icon w-5 h-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <!-- Center circle -->
    <circle cx="12" cy="12" r="4" fill="currentColor" stroke="none" />
    <!-- Rays -->
    <line x1="12" y1="2" x2="12" y2="5" />
    <line x1="12" y1="19" x2="12" y2="22" />
    <line x1="2" y1="12" x2="5" y2="12" />
    <line x1="19" y1="12" x2="22" y2="12" />
    <line x1="4.22" y1="4.22" x2="6.34" y2="6.34" />
    <line x1="17.66" y1="17.66" x2="19.78" y2="19.78" />
    <line x1="4.22" y1="19.78" x2="6.34" y2="17.66" />
    <line x1="17.66" y1="6.34" x2="19.78" y2="4.22" />
  </svg>

  <!-- Moon icon: visible when light mode is active (clicking switches to dark) -->
  <svg
    class="moon-icon w-5 h-5"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <!-- Crescent moon path -->
    <path
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      fill="currentColor"
      stroke="none"
    />
  </svg>
</button>

<style>
  .electric-toggle:hover {
    color: var(--color-accent);
    transform: rotate(12deg) scale(1.08);
    box-shadow: 0 0 18px var(--color-glow);
  }

  .electric-toggle :global(svg) {
    filter: drop-shadow(0 0 6px var(--color-glow));
  }

  /* Show sun icon only when dark mode is active */
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  /* Show moon icon only when light mode is active */
  :global([data-theme="light"]) .sun-icon {
    display: none;
  }

  /* Fallback: if no data-theme is set, default to dark mode behavior (hide moon) */
  :global(html:not([data-theme="light"])) .moon-icon {
    display: none;
  }
</style>

<script>
  const btn = document.getElementById("theme-toggle");

  function updateAriaLabel(theme: string) {
    if (btn) {
      btn.setAttribute(
        "aria-label",
        theme === "dark" ? "Cambiar a modo claro" : "Cambiar a modo oscuro"
      );
    }
  }

  // Set initial aria-label based on current theme
  const initialTheme = document.documentElement.getAttribute("data-theme") ?? "dark";
  updateAriaLabel(initialTheme);

  btn?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") ?? "dark";
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    updateAriaLabel(next);
  });
</script>
